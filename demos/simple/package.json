{
  "type": "module",
  "name": "@denshya/proton-demo",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "dev:profile": "vite --profile",
    "build": "vite build",
    "preview": "vite preview",
    "stats": "bun stats:treemap && bun stats:sunburst",
    "stats:treemap": "vite-bundle-visualizer --sourcemap -o ./stats/treemap.html",
    "stats:sunburst": "vite-bundle-visualizer -o ./stats/sunburst.html -t sunburst",
    "stats:network": "vite-bundle-visualizer -o ./stats/network.html -t network"
  },
  "dependencies": {
    "@denshya/reactive": "../../../flow/denshya-reactive-0.11.0v1.tgz",
    "@denshya/tama": "../../denshya-tama-0.8.08.tgz",
    "iterator-helpers-polyfill": "^3.0.1",
    "urlpattern-polyfill": "^10.1.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "10.0.2",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "sass": "^1.97.3",
    "type-fest": "^5.4.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-bundle-visualizer": "^1.2.1"
  },
  "engines": {
    "bun": "1.1.45"
  }
}
